using RimWorld;
using System;
using System.Collections.Generic;
using System.Text;
using UnityEngine.Assertions.Comparers;
using Verse;

namespace Utility_Usage
{

    public class PowerManager
    {
        public float PowerConsumptionTotal { get; private set; }
        public float PowerProductionTotal { get; private set; }
        public float NetPower { get; private set; }

        public float ConsumptionCount { get; private set; }
        public float ProductionCount { get; private set; }

        public void GetCurrentState(out List<string> returnLabel, out List<float> returnPower)
        {
            PowerConsumptionTotal = 0f;
            PowerProductionTotal = 0f;

            returnLabel = new List<string>();
            returnPower = new List<float>();

            CompPowerTrader component;
            string labelComp;

            if (Find.CurrentMap?.powerNetManager?.AllNetsListForReading != null)
            {
                float rate;

                foreach (PowerNet network in Find.CurrentMap.powerNetManager.AllNetsListForReading)
                {
                    if (network == null)
                        continue;

                    for (int i = 0; i <network.powerComps.Count; i++)
                    {
                        component = network.powerComps[i];

                        if (component == null)
                            continue;

                        rate = component.EnergyOutputPerTick;
                        labelComp = component.parent.LabelCap;

                        if (!component.PowerOn)
                            continue;

                        if (rate > 0f)
                        {
                            returnLabel.Insert(i, labelComp);
                            returnPower.Insert(i, rate);

                            PowerProductionTotal += rate;

                            ProductionCount++;
                        }
                        else if (rate < 0f)
                        {
                            returnLabel.Insert(i, labelComp);
                            returnPower.Insert(i, -rate);

                            PowerConsumptionTotal += -rate;

                            ConsumptionCount++;
                        }
                    }
                }
            }
            NetPower = PowerProductionTotal - PowerConsumptionTotal;
        }

        public string ListComps()
        {
            
            StringBuilder finalResult = new StringBuilder();
            PowerManager powerMan = new PowerManager();

            List<string> labels = new List<string>();
            List<float> power = new List<float>();

            power.GetCurrentState(out labels, out power);

            foreach (PowerNet network in Find.CurrentMap.powerNetManager.AllNetsListForReading)
            {
                if (network == null)
                    continue;

                foreach (CompPowerTrader component in network.powerComps)
                {
                    if (component == null)
                        continue;


                }
            }
        }
    }
}
